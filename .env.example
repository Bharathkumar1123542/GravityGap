# Gemini AI
# Get your key from https://aistudio.google.com/apikey
# Restrict it to the Generative Language API in Google console
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your_key_here

# Upstash Redis (for rate limiting on /api/ask)
# Create a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=your_url_here
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Rate limits (per IP, used by lib/server/ratelimit.ts)
RATE_PER_MINUTE=10
RATE_PER_DAY=60

# IP hashing salt (any long random string; never commit the real value)
IP_SALT=change_this_to_a_random_secret
