    "data:validate": "tsx scripts/validate-data.ts",
    "data:report": "tsx scripts/data-report.ts",
    "golden": "tsx scripts/golden.ts"
  },
  "dependencies": {
    "@google/genai": "1.3.0",
    "@upstash/ratelimit": "2.0.5",
    "@upstash/redis": "1.34.3",
    "next": "15.3.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.29",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitest/coverage-v8": "3.2.3",
    "autoprefixer": "10.4.21",
    "eslint": "9.28.0",
    "eslint-config-next": "15.3.4",
    "jsdom": "26.1.0",
    "postcss": "8.5.4",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
